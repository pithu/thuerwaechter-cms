#KONSOLEH AREA START - PLEASE DO NOT EDIT MANUALLY BETWEEN THESE LINES
#KONSOLEH AREA END - PLEASE ADD MANUAL CHANGES BELOW

RewriteEngine On

# thuerwaechter.de -> www.thuerwaechter.de
RewriteCond %{HTTP_HOST} ^thuerwaechter\.de$ [NC]
RewriteRule ^ https://www.thuerwaechter.de%{REQUEST_URI} [R=301,L]

# http -> https
RewriteCond %{HTTPS} off
RewriteRule ^ https://www.thuerwaechter.de%{REQUEST_URI} [R=301,L]
